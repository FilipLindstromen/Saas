{
  "name": "broll-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node server/index.mjs\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "electron": "electron .",
    "desktop": "npm run build && electron .",
    "package:win": "electron-packager electron BRollEditor --platform=win32 --arch=x64 --out=. --overwrite --no-asar"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.526",
    "@remotion/google-fonts": "^4.0.526",
    "@remotion/player": "^4.0.526",
    "@remotion/renderer": "^4.0.526",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.526"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@remotion/cli": "^4.0.526",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
