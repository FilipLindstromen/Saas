// BrainDump - Voice capture and thought organization
// Database schema for dumps, organized items, projects, and tags

generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Dump {
  id                String    @id @default(cuid())
  mode              String    @default("inbox") // inbox | work | personal
  userId            String
  audioUrl          String?   // reference to stored audio (URL or blob key)
  transcriptRaw     String    @default("")
  transcriptEdited  String    @default("")
  status            String    @default("draft") // draft | transcribed | organized | saved
  createdAt         DateTime  @default(now())
  organizedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizedItems   OrganizedItem[]

  @@index([userId, mode, status])
  @@index([userId, createdAt])
}

model OrganizedItem {
  id               String    @id @default(cuid())
  dumpId           String
  userId           String
  domain           String    // inbox | work | personal
  category         String
  subcategory      String    @default("")
  projectId        String?
  itemType         String    // task | shopping | note | idea | emotion | reflection | reminder | problem | decision | journal_entry | project_update
  title            String
  content          String    @default("")
  emotionLabel     String?
  status           String    @default("draft") // draft | needs_review | approved | saved
  progress         String    @default("todo")  // todo | completed (legacy: started)
  priority         Int?      // nullable
  recommendedView  String    @default("note_cards")
  confidenceScore   Float     @default(0)
  positionX        Float?    // for kanban/post-its layout
  positionY        Float?
  kanbanColumn     String?   // todo | completed; itemType task_completed = done
  scheduledAt      DateTime? // date/time for calendar (date part = day, time optional)
  scheduledTime    String?   // e.g. "09:00" for display/notification
  recurrence       String?   // none | daily | weekly | monthly
  sendNotification Boolean?  @default(false)
  reminderAt             DateTime? // when to send the main reminder notification
  reminderMinutesBefore  Int?     // also notify this many minutes before (0 = no early notification)
  reminderNotifiedAt     DateTime? // set when main reminder was sent
  reminderEarlyNotifiedAt DateTime? // set when early (X min before) reminder was sent
  /// Manual order for list/text views (ascending: smaller = higher in UI). Tie-break: createdAt desc when equal.
  listOrder        Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Soft-delete: set when user moves item to trash; null = active.
  deletedAt        DateTime?

  dump     Dump     @relation(fields: [dumpId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags     OrganizedItemTag[]

  @@index([userId, dumpId])
  @@index([userId, domain, category])
  @@index([userId, domain, deletedAt])
  @@index([userId, projectId])
  @@index([userId, itemType])
  @@index([userId, status])
  @@index([userId, scheduledAt])
  @@index([userId, deletedAt])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  domain      String    @default("work") // work | personal
  description String    @default("")
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrganizedItem[]
}

model Tag {
  id   String @id @default(cuid())
  name String
  userId String

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  items OrganizedItemTag[]

  @@unique([userId, name])
}

model OrganizedItemTag {
  itemId String
  tagId  String

  item OrganizedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

/// Auth.js / NextAuth user model (credentials: passwordHash set; OAuth: accounts used)
model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?    // for email/password sign-in only
  /// Client-only UI settings (localStorage mirror) for cross-device sync — not secrets; OAuth tokens stay local.
  clientPreferences Json     @default("{}")

  accounts           Account[]
  sessions           Session[]
  dumps              Dump[]
  items              OrganizedItem[]
  projects           Project[]
  tags               Tag[]
  passwordResetTokens PasswordResetToken[]
  gamification         UserGamification?

  @@index([createdAt])
}

/// Server-backed XP for capture (dumps) and task completion — see /api/gamification.
model UserGamification {
  userId                  String   @id
  /** Number of voice/text dumps created (POST /api/dumps). */
  dumpsCapturedCount      Int      @default(0)
  /** Lifetime task completions (incremented when a task is marked done). */
  tasksCompletedLifetime  Int      @default(0)
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Singleton row with `id: "global"` for server-controlled feature flags (admin dashboard).
model SiteSettings {
  id                String   @id
  revenueCatEnabled Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// One-time token for email/password reset flow
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Auth.js / NextAuth account model
model Account {
  userId                 String
  type                   String
  provider               String
  providerAccountId      String
  refresh_token          String?  @db.Text
  access_token           String?  @db.Text
  expires_at             Int?
  token_type             String?
  scope                  String?
  id_token               String?  @db.Text
  session_state          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

/// Auth.js / NextAuth session model
model Session {
  sessionToken String  @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js / NextAuth email verification / magic link tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
