# frozen_string_literal: true

require "base64"
require "securerandom"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (App Store Connect API key required)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: false
    )

    setup_ci if ENV["CI"]

    if ENV["MATCH_PASSWORD"]
      UI.message("Using Fastlane Match (readonly)")
      match(
        type: "appstore",
        readonly: true,
        app_identifier: ["com.braindump.app"],
        api_key: api_key
      )
    elsif ENV["APPLE_CERTIFICATE_BASE64"]
      UI.message("Using imported distribution certificate + provisioning profile")
      keychain_name = ENV["KEYCHAIN_NAME"] || "braindump-ci.keychain"
      keychain_password = ENV["KEYCHAIN_PASSWORD"] || SecureRandom.hex(32)

      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      cert_path = File.join(Dir.tmpdir, "distribution.p12")
      File.binwrite(cert_path, Base64.decode64(ENV["APPLE_CERTIFICATE_BASE64"]))

      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["APPLE_CERTIFICATE_PASSWORD"] || "",
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      profile_path = File.join(Dir.tmpdir, "profile.mobileprovision")
      File.binwrite(profile_path, Base64.decode64(ENV.fetch("APPLE_PROVISION_PROFILE_BASE64")))
      install_provisioning_profile(path: profile_path)

      update_code_signing_settings(
        path: "App/App.xcodeproj",
        use_automatic_signing: false,
        targets: ["App"],
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        bundle_identifier: "com.braindump.app",
        profile_name: ENV.fetch("APPLE_PROVISIONING_PROFILE_NAME"),
        code_sign_identity: "Apple Distribution"
      )
    else
      UI.user_error!("Set MATCH_PASSWORD (Match) or APPLE_CERTIFICATE_BASE64 + APPLE_PROVISION_PROFILE_BASE64 (manual)")
    end

    if ENV["BUILD_NUMBER"]
      increment_build_number(
        build_number: ENV["BUILD_NUMBER"],
        xcodeproj: "App/App.xcodeproj"
      )
    end

    gym(
      scheme: "App",
      project: "App/App.xcodeproj",
      export_method: "app-store",
      clean: true,
      output_directory: "./output",
      output_name: "BrainDump.ipa",
      xcargs: "-skipPackagePluginValidation -skipMacroValidation"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
