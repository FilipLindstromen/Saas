# Postgres connection string (from Vercel Storage, Neon, etc.)
# The app picks the first non-empty of: DATABASE_URL, NEON_DATABASE_URL, POSTGRES_PRISMA_URL, POSTGRES_URL, …
# Pooled Neon/Supabase URLs get pgbouncer=true automatically when needed for Prisma’s pg driver.
# Do not leave DATABASE_URL defined but blank — that blocks fallbacks.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# --- Prisma CLI against your Vercel *production* database (optional) ---
# Your normal .env often uses localhost; that does NOT affect Vercel. Do this from the BrainDump
# folder (where package.json / vercel.json live), in order — link first, or env pull will error:
#
#   1) npm.cmd run vercel:link
#   2) npm.cmd run vercel:env:production
#   3) npm.cmd run db:migrate:vercel   (or db:push:vercel)
#
# Step 2 creates .env.vercel.production (gitignored). Uses npx inside npm scripts — no global
# "vercel" install needed.
#
# Windows PowerShell: typing "npx" or "vercel" alone may run *.ps1 and fail with "running scripts
# is disabled". Prefer npm.cmd run … as above, or Command Prompt (cmd.exe), or:
#   Set-ExecutionPolicy -Scope CurrentUser RemoteSigned
# You can also use npx.cmd vercel link if npx.ps1 is blocked.
#
# Prisma does not override existing env vars with .env when vars are already set; dotenv-cli sets
# DATABASE_URL from that file before Prisma runs.
#
# Vercel build (`build:vercel`) runs scripts/vercel-prisma-migrate.cjs: if Prisma reports P3005
# (database not empty but no migration history), it baselines migrations then `db push` once to match schema.

# --- RevenueCat Web Billing (Filip Lindstrom / BrainDump web) ---
# Public SDK key from RevenueCat → Apps & providers → your Web Billing app (safe in the browser).
# Use the test_ key locally; production uses the live public key (not the secret API key).
# NEXT_PUBLIC_REVENUECAT_API_KEY="test_..."
# Entitlement identifier in RevenueCat (default filip_lindstrom_pro). Display name can be "Filip Lindstrom Pro".
# NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID="filip_lindstrom_pro"
# Dashboard: attach Paywall to default offering; packages for monthly, yearly, lifetime products.

# Server-side API keys and OAuth credentials (set by the developer, not end users)
OPENAI_API_KEY="your-openai-api-key"

# NextAuth v5: required for signing cookies/tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-at-least-32-chars"

# Comma- or semicolon-separated emails allowed to open /admin (use your normal BrainDump login).
# Example: ADMIN_EMAILS="you@yourdomain.com,other@yourdomain.com"
# ADMIN_EMAILS=""

# Canonical public URL of this app (no trailing slash). Required for correct OAuth redirect URIs in production.
# Local:  AUTH_URL="http://localhost:3000"
# Vercel: AUTH_URL="https://your-project.vercel.app"  (or your custom domain, same as users see in the browser)
AUTH_URL="http://localhost:3000"

# --- Sign in with Google (optional) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript origins (add each origin you use):
#   http://localhost:3000
#   https://your-production-domain.com
#
# Authorized redirect URIs — must match Auth.js exactly (copy from your running app if unsure):
#   http://localhost:3000/api/auth/callback/google
#   https://your-production-domain.com/api/auth/callback/google
#
# To print the URIs this deployment expects, open GET /api/auth/oauth-redirect-hints in the browser.
#
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- Sign in with Apple (optional) ---
# APPLE_SERVICE_ID: Apple Developer “Services ID” (acts as client id for web).
# AUTH_APPLE_ID / AUTH_APPLE_SECRET or configure per Auth.js Apple docs.
# Redirect URI in Apple must include: {AUTH_URL origin}/api/auth/callback/apple
#
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# --- Password reset emails ---
# Without a mail transport, "Forgot password" will not deliver (local dev may show a reset link in the API response instead).
#
# Option A — Resend (https://resend.com): preferred if you use their API
# 1) API key → RESEND_API_KEY (Vercel: Project → Settings → Environment Variables)
# 2) Verify a domain in Resend → Domains, then e.g. EMAIL_FROM="BrainDump <noreply@yourdomain.com>"
#    (Default onboarding@resend.dev is for limited testing only.)
#
# RESEND_API_KEY="re_..."
# EMAIL_FROM="BrainDump <noreply@your-verified-domain.com>"
#
# Option B — SMTP (any provider: Gmail app password, SendGrid SMTP, Mailgun, etc.)
# EMAIL_FROM is required. Use either a single URL or host + auth:
#
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# EMAIL_FROM="BrainDump <noreply@yourdomain.com>"
#
# Or:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="..."
# SMTP_PASSWORD="..."
# EMAIL_FROM="BrainDump <noreply@yourdomain.com>"
#
# Redeploy after changing env vars.

# Legacy alias; prefer AUTH_URL above. If only NEXTAUTH_URL is set, it is still honored.
# NEXTAUTH_URL="https://your-domain.com"

# Optional: stock media (used by ReelRecorder / shared pickers; set if you use those features)
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
PEXELS_API_KEY="your-pexels-api-key"
GIPHY_API_KEY="your-giphy-api-key"
