# Postgres connection string (from Vercel Storage, Neon, etc.)
# On Vercel Postgres, POSTGRES_PRISMA_URL / POSTGRES_URL are used if DATABASE_URL is missing *or empty*.
# Do not leave DATABASE_URL defined but blank — that would block the fallbacks.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Server-side API keys and OAuth credentials (set by the developer, not end users)
OPENAI_API_KEY="your-openai-api-key"

# NextAuth v5: required for signing cookies/tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-at-least-32-chars"

# Canonical public URL of this app (no trailing slash). Required for correct OAuth redirect URIs in production.
# Local:  AUTH_URL="http://localhost:3000"
# Vercel: AUTH_URL="https://your-project.vercel.app"  (or your custom domain, same as users see in the browser)
AUTH_URL="http://localhost:3000"

# --- Sign in with Google (optional) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript origins (add each origin you use):
#   http://localhost:3000
#   https://your-production-domain.com
#
# Authorized redirect URIs — must match Auth.js exactly (copy from your running app if unsure):
#   http://localhost:3000/api/auth/callback/google
#   https://your-production-domain.com/api/auth/callback/google
#
# To print the URIs this deployment expects, open GET /api/auth/oauth-redirect-hints in the browser.
#
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- Sign in with Apple (optional) ---
# APPLE_SERVICE_ID: Apple Developer “Services ID” (acts as client id for web).
# AUTH_APPLE_ID / AUTH_APPLE_SECRET or configure per Auth.js Apple docs.
# Redirect URI in Apple must include: {AUTH_URL origin}/api/auth/callback/apple
#
# AUTH_APPLE_ID=""
# AUTH_APPLE_SECRET=""

# --- Password reset emails (Resend — https://resend.com) ---
# Without these, "Forgot password" will not deliver mail (local dev may show a reset link in the UI instead).
#
# 1) Create an API key in Resend → API Keys. On Vercel: Project → Settings → Environment Variables → RESEND_API_KEY
# 2) Verify a domain in Resend → Domains, then set e.g.:
#    EMAIL_FROM="BrainDump <noreply@yourdomain.com>"
#    (The default onboarding@resend.dev works only for limited testing; production should use a verified domain.)
# 3) Redeploy so the server picks up new variables.
#
# RESEND_API_KEY="re_..."
# EMAIL_FROM="BrainDump <noreply@your-verified-domain.com>"

# Legacy alias; prefer AUTH_URL above. If only NEXTAUTH_URL is set, it is still honored.
# NEXTAUTH_URL="https://your-domain.com"

# Optional: stock media (used by ReelRecorder / shared pickers; set if you use those features)
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"
PEXELS_API_KEY="your-pexels-api-key"
GIPHY_API_KEY="your-giphy-api-key"
