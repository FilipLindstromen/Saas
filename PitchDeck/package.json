{
  "name": "pitch-deck-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pitch Deck 2000 — presentation builder with recording and video export",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg-core.mjs && vite",
    "build": "node scripts/copy-ffmpeg-core.mjs && vite build",
    "build:electron": "node scripts/copy-ffmpeg-core.mjs && vite build --mode electron",
    "preview": "vite preview",
    "server": "cd server && npm start",
    "server:install": "cd server && npm install",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5174 && cross-env NODE_ENV=development electron .\"",
    "electron:pack": "npm run build:electron && npm run server:install && electron-builder --dir",
    "electron:build": "npm run build:electron && npm run server:install && electron-builder",
    "electron:build:win": "npm run build:electron && npm run server:install && electron-builder --win"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pitchdeck.app",
    "productName": "Pitch Deck 2000",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!tmp/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
