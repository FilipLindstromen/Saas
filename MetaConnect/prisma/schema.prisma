// MetaConnect — Meta automation + Systeme.io CRM integration
// Handles FB/IG comment-to-DM flows and lead form syncing

generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// App user with email/password credentials
model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  metaConnections     MetaConnection[]
  systemeioConnection SystemeioConnection?
  projects            Project[]

  @@index([createdAt])
}

/// One-time token for password reset flow
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A connected Facebook Page (with optional linked Instagram account)
model MetaConnection {
  id                 String   @id @default(cuid())
  userId             String
  pageId             String
  pageName           String
  pageAccessToken    String   @db.Text
  igAccountId        String?
  igName             String?
  webhookSubscribed  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([userId, pageId])
  @@index([userId])
}

/// Systeme.io API key per user (one per user)
model SystemeioConnection {
  id        String   @id @default(cuid())
  userId    String   @unique
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A project ties a Meta page to an automation type
model Project {
  id               String   @id @default(cuid())
  userId           String
  metaConnectionId String
  name             String
  /// "comment" | "lead_form"
  type             String
  /// "active" | "paused"
  status           String   @default("active")
  systemeioTag     String
  // Comment project fields
  keyword          String?
  postId           String?
  dmMessage        String?  @db.Text
  responseMessage  String?  @db.Text
  // Lead form project fields
  formId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaConnection MetaConnection @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
  leads          Lead[]
  conversations  Conversation[]

  @@index([userId])
  @@index([metaConnectionId])
}

/// A collected lead (from either comment flow or lead form)
model Lead {
  id        String   @id @default(cuid())
  projectId String
  name      String
  email     String
  metaUserId String?
  /// "comment" | "lead_form"
  source    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, createdAt])
}

/// Active DM conversation for comment-to-DM flow (awaiting name/email reply)
model Conversation {
  id        String   @id @default(cuid())
  projectId String
  /// Page-scoped ID (PSID) for Messenger or Instagram IGSID
  psid      String
  /// "awaiting_name" | "awaiting_email" | "completed" | "failed"
  state     String   @default("awaiting_name")
  name      String?
  email     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, psid])
  @@index([psid])
}

// ─── NextAuth / Auth.js models ───────────────────────────────────────────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
